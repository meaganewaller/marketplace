#!/usr/bin/env bash
#
# claude-extract-session - Extract a Claude session by session ID
#
# Usage: claude-extract-session <session-id>
#
# Takes a session ID (UUID or agent-prefixed ID) and outputs the detailed
# markdown conversation to stdout.

[[ -n "${DEBUG:-}" ]] && set -o xtrace
set -o errexit
set -o errtrace
set -o nounset
set -o pipefail

readonly SCRIPT_NAME="${0##*/}"

# Print message to stderr
log() {
	printf '%s: %s\n' "${SCRIPT_NAME}" "$*" >&2
}

# Print error and exit
die() {
	log "error: $*"
	exit 1
}

# Show usage information
usage() {
	cat >&2 <<EOF
Usage: ${SCRIPT_NAME} <session-id>

Extract a Claude session by its session ID and output markdown to stdout.

Arguments:
    session-id    UUID (e.g., 907cd44d-b368-4cd3-b569-ccc25192f01d) or
                  agent-prefixed ID (e.g., agent-a5b6c7d8)

Options:
    -h, --help    Show this help message

Examples:
    ${SCRIPT_NAME} 907cd44d-b368-4cd3-b569-ccc25192f01d
    ${SCRIPT_NAME} agent-a5b6c7d8
EOF
	exit 1
}

# Validate session ID format (UUID or agent-prefixed)
validate_session_id() {
	local session_id="$1"

	# UUID format: 8-4-4-4-12 hex characters
	local uuid_pattern='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'

	# Agent-prefixed format: agent-<hex>
	local agent_pattern='^agent-[0-9a-fA-F]+$'

	if [[ "${session_id}" =~ ${uuid_pattern} ]]; then
		return 0
	elif [[ "${session_id}" =~ ${agent_pattern} ]]; then
		return 0
	else
		return 1
	fi
}

# How many times to re-list and re-extract before giving up. claude-extract
# only selects by list position, and the list is ordered by modification time,
# so any session that writes to its log between our --list and its --extract
# shifts the positions. Each attempt verifies what came out, so a retry costs
# time, never correctness.
readonly MAX_ATTEMPTS=3

# Fail unless exactly one transcript on disk carries the full session ID.
#
# The list shows only eight characters of each ID, which is not enough to tell
# sessions apart -- agent IDs all share "agent-" and leave two hex digits. The
# full ID is the transcript's filename, so check that first.
require_transcript() {
	local target_id="$1"
	local projects_dir="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}/projects"
	local matches count

	[[ -d "${projects_dir}" ]] || die "no Claude projects directory at ${projects_dir}"

	matches=$(find "${projects_dir}" -type f -name "${target_id}.jsonl" 2>/dev/null)
	count=$(printf '%s' "${matches}" | grep -c . || true)

	if [[ "${count}" -eq 0 ]]; then
		die "no transcript named ${target_id}.jsonl under ${projects_dir}"
	fi
	if [[ "${count}" -gt 1 ]]; then
		log "transcripts found:"
		printf '%s\n' "${matches}" >&2
		die "more than one transcript is named ${target_id}.jsonl"
	fi
}

# Print the list positions whose truncated ID matches the target's first
# eight characters, one per line, from claude-extract --list output.
#
# Format:
#   N. <folder>
#      Session: <truncated-id>...
find_candidates() {
	local target_id="$1"
	local session_prefix="${target_id:0:8}"
	local list_output

	if ! list_output=$(claude-extract --list 2>&1); then
		log "claude-extract --list failed; output was:"
		printf '%s\n' "${list_output}" >&2
		die "failed to list sessions"
	fi

	local current_number=""
	while IFS= read -r line; do
		# Match numbered entry line (e.g., "1. <folder>")
		if [[ "${line}" =~ ^[[:space:]]*([0-9]+)\. ]]; then
			current_number="${BASH_REMATCH[1]}"
		fi

		# Match session line (e.g., "   Session: 907cd44d...")
		if [[ "${line}" =~ Session:[[:space:]]*([^.]+) ]]; then
			if [[ "${BASH_REMATCH[1]}" == "${session_prefix}" ]]; then
				printf '%s\n' "${current_number}"
			fi
		fi
	done <<<"${list_output}"
}

# Return 0 if the markdown file's header names exactly this session.
#
# Only the header counts: the body is the conversation itself, and a session
# that discusses another session's ID would otherwise pass for it.
is_session() {
	local file="$1"
	local target_id="$2"

	head -n 4 "${file}" | grep -qxF "Session ID: ${target_id}"
}

# Extract the list entry at one position into a fresh directory, and print the
# markdown file's path if it is the target session.
extract_candidate() {
	local session_number="$1"
	local target_id="$2"
	local outdir="$3"

	mkdir -p "${outdir}" || die "failed to create ${outdir}"

	# Run claude-extract with detailed output
	if ! claude-extract \
		--detailed \
		--extract "${session_number}" \
		--output "${outdir}" \
		>&2; then
		die "failed to extract session"
	fi

	local file
	for file in "${outdir}"/*.md; do
		[[ -f "${file}" ]] || continue
		if is_session "${file}" "${target_id}"; then
			printf '%s' "${file}"
			return 0
		fi
	done
	return 1
}

# Extract the target session and print its markdown, or exit non-zero having
# printed nothing to stdout.
extract_session() {
	local target_id="$1"
	local tmpdir

	# Create temporary directory for extraction
	tmpdir=$(mktemp -d) || die "failed to create temporary directory"

	# Ensure cleanup on exit. Expand $tmpdir at trap registration (double quotes)
	# rather than at trap firing — the local var goes out of scope when the
	# function returns, but EXIT fires later, triggering set -u.
	# shellcheck disable=SC2064
	trap "rm -rf -- '${tmpdir}'" EXIT

	local attempt candidates session_number file
	for ((attempt = 1; attempt <= MAX_ATTEMPTS; attempt++)); do
		candidates=$(find_candidates "${target_id}")
		if [[ -z "${candidates}" ]]; then
			log "attempt ${attempt}: no listed session starts with '${target_id:0:8}'"
			continue
		fi

		# One extraction per candidate, each into its own directory: the
		# extractor names files by date and the same eight characters, so
		# candidates extracted together can overwrite each other.
		while IFS= read -r session_number; do
			log "attempt ${attempt}: extracting session #${session_number}..."
			if file=$(extract_candidate "${session_number}" "${target_id}" \
				"${tmpdir}/${attempt}-${session_number}"); then
				cat "${file}"
				return 0
			fi
		done <<<"${candidates}"

		log "attempt ${attempt}: the list moved before extraction; no extracted file is session ${target_id}"
	done

	die "could not extract session ${target_id} after ${MAX_ATTEMPTS} attempts"
}

main() {
	# Handle help flag
	if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
		usage
	fi

	# Validate arguments
	if [[ $# -ne 1 ]]; then
		die "expected 1 argument, got $#. Use --help for usage."
	fi

	local session_id="$1"

	# Validate session ID format
	if ! validate_session_id "${session_id}"; then
		die "invalid session ID format: '${session_id}'"
	fi

	# Check claude-extract is available
	if ! command -v claude-extract &>/dev/null; then
		die "claude-extract not found in PATH"
	fi

	require_transcript "${session_id}"

	# Extract and output
	extract_session "${session_id}"
}

main "$@"
