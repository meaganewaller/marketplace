#!/usr/bin/env bash
#
# claude-session-gist - Publish the current claude session as a secret gist,
# UNLESS the current repo's git remote is on the blocklist.
#
# Usage: claude-session-gist <session-id> [branch-name]
#
# Behavior:
#   - If any git remote of the current repo matches a blocked pattern, this
#     refuses BEFORE extracting or uploading anything: it prints an explanation
#     to stderr and exits 3 with NO stdout. The caller MUST then
#     omit the conversation-log link from the PR body.
#   - Otherwise, it extracts the session (via the sibling claude-extract-session shim)
#     and pipes it to `gh gist create` (secret by default), printing the
#     resulting Gist URL - and nothing else - to stdout.
#
# The blocklist is rendered from the `MW_MARKETPLACE_CLAUDE_SESSION_GIST_BLOCKLIST`
# environment variable.

[[ -n "${DEBUG:-}" ]] && set -o xtrace
set -o errexit
set -o errtrace
set -o nounset
set -o pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly SCRIPT_DIR="${0%/*}"
readonly EXIT_BLOCKED=3

log() {
    printf '%s: %s\n' "${SCRIPT_NAME}" "$*" >&2
}

# Lowercase a string.
#
# This deliberately shells out to `tr` instead of using `${var,,}`: macOS ships
# bash 3.2.57, where `${var,,}` is a runtime "bad substitution" error. This
# script runs under `#!/usr/bin/env bash`, which finds /bin/bash on a default
# PATH -- so the blocklist never evaluated on the machine it exists to protect,
# and every repo with a remote died at exit 1 instead. `bash -n` and shellcheck
# both pass on `${var,,}`, so only running it under bash 3.2 catches this;
# test/claude-session-gist.bats does exactly that. LC_ALL=C keeps this to ASCII,
# which is all a host or org name can contain.
to_lower() {
    printf '%s' "$1" | LC_ALL=C tr '[:upper:]' '[:lower:]'
}

# Print error and exit
die() {
    log "error: $*"
    exit 1
}

# Path to the settings file that stores plugin option values.
#
# Honors CLAUDE_CONFIG_DIR, which is how Claude Code relocates the config
# directory. Hardcoding ~/.claude would silently read nothing for anyone who
# has moved it -- and "read nothing" means "block nothing".
user_settings_path() {
    printf '%s/settings.json' "${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
}

# Resolve the raw blocklist string, in order of precedence:
#
#   1. MW_MARKETPLACE_CLAUDE_SESSION_GIST_BLOCKLIST -- explicit override. The
#      only source that works in a bare shell, a test harness, or CI.
#   2. CLAUDE_PLUGIN_OPTION_GIST_BLOCKLIST -- exported by Claude Code from the
#      plugin's `userConfig`, but only to HOOK processes. Present if a hook
#      runs this; absent when the pr skill invokes it through the Bash tool.
#   3. pluginConfigs[<plugin-id>].options.gist_blocklist in user settings --
#      where `userConfig` actually persists the value, and so the only source
#      that covers the normal /pr path. See the plugins reference: components
#      that run in a shell are told to read the value from a config file.
resolve_blocklist() {
    if [[ -n "${MW_MARKETPLACE_CLAUDE_SESSION_GIST_BLOCKLIST:-}" ]]; then
        printf '%s' "${MW_MARKETPLACE_CLAUDE_SESSION_GIST_BLOCKLIST}"
        return 0
    fi

    if [[ -n "${CLAUDE_PLUGIN_OPTION_GIST_BLOCKLIST:-}" ]]; then
        printf '%s' "${CLAUDE_PLUGIN_OPTION_GIST_BLOCKLIST}"
        return 0
    fi

    local settings
    settings=$(user_settings_path)
    [[ -r "${settings}" ]] || return 0

    # Only jq parses this. A regex over JSON would return a confidently wrong
    # answer on a control whose entire job is to not leak, so if the file
    # mentions the option and jq is missing, refuse instead of guessing.
    if ! command -v jq &>/dev/null; then
        if grep -q 'gist_blocklist' "${settings}" 2>/dev/null; then
            die "a gist blocklist is configured in ${settings} but jq is not installed to read it"
        fi
        return 0
    fi

    # The pluginConfigs key embeds a marketplace-dependent plugin id, so select
    # by plugin name instead of assuming its exact format.
    jq -r '
        (.pluginConfigs // {})
        | to_entries
        | map(select(.key | test("git-workflow")))
        | map(.value.options.gist_blocklist // empty)
        | first // ""
    ' "${settings}" 2>/dev/null || return 0
}

# Remote patterns whose repositories must never have their conversation logs
# extracted or published, as whitespace-separated globs.
#
# This must be a real array: repo_is_blocked() indexes it with `[@]`, and a
# scalar assigned here dies with "unbound variable" under `set -o nounset` on
# bash 3.2 -- which is every default macOS shell, so the blocklist never ran on
# the machine it exists to protect. Split with `read -ra` rather than an
# unquoted array assignment: the latter also applies pathname expansion, and
# these patterns contain `*` that must reach the matcher literally.
BLOCKED_REMOTE_PATTERNS=()
blocklist_raw=$(resolve_blocklist)
if [[ -n "${blocklist_raw}" ]]; then
    read -ra BLOCKED_REMOTE_PATTERNS <<< "${blocklist_raw}"
fi
unset blocklist_raw
readonly BLOCKED_REMOTE_PATTERNS

usage() {
    cat >&2 <<EOF
Usage: ${SCRIPT_NAME} <session-id> [branch-name]

Publish the current Claude session as a secret Gist, unless the current
repository's git remote is on the gist blocklist.

Arguments:
    session-id    UUID or agent-prefixed ID of the session to publish
    branch-name   Optional; defaults to the current branch. Used only to name
                  the Gist file.

Options:
    -h, --help    Show this help message

Exit codes:
    0   Gist created; URL printed to stdout
    3   Repository is blocklisted; nothing extracted or uploaded
    1   Error
EOF
    exit 1
}

# Normalize a git remote URL to a canonical, lowercased `host/org/repo` form so
# that HTTPS and scp-style SSH remotes for the same repo compare equal.
#   https://github.com/Gusto/repo.git -> github.com/gusto/repo.git
#   git@github.com:Gusto/repo.git     -> github.com/gusto/repo.git
#   ssh://git@github.com/Gusto/repo   -> github.com/gusto/repo
normalize_remote() {
    local url="$1"
    local sep='/'

    url="${url#*://}"   # strip scheme://
    url="${url#*@}"     # strip user@
    url="${url/:/$sep}" # scp-style host:path -> host/path
    to_lower "${url}"
}


# Return 0 if the current repo has any remote matching the blocklist.
repo_is_blocked() {
    # No patterns configured -> nothing is ever blocked.
    if [[ "${#BLOCKED_REMOTE_PATTERNS[@]}" -eq 0 ]]; then
        return 1
    fi

    # Not a git repo (or no remotes) -> nothing to match against.
    local remotes
    if ! remotes=$(git remote 2>/dev/null) || [[ -z "${remotes}" ]]; then
        return 1
    fi

    local remote url norm pattern pattern_lc
    while IFS= read -r remote; do
        [[ -z "${remote}" ]] && continue
        url=$(git remote get-url "${remote}" 2>/dev/null) || continue

        # Fail CLOSED. If a remote exists but cannot be normalized, we cannot
        # prove it is safe to publish. A false block costs one missing PR link;
        # a false pass leaks a work conversation log to a Gist.
        norm=$(normalize_remote "${url}") || norm=''
        if [[ -z "${norm}" ]]; then
            log "blocked: could not normalize remote '${url}'"
            return 0
        fi

        for pattern in "${BLOCKED_REMOTE_PATTERNS[@]}"; do
            pattern_lc=$(to_lower "${pattern}")
            # RHS must stay UNQUOTED so [[ == ]] treats it as a glob, not a
            # literal; quoting it silently turns the blocklist into exact-match
            # and lets work repos through.
            # shellcheck disable=SC2053 # intentional glob match
            if [[ "${norm}" == ${pattern_lc} ]]; then
                log "blocked: remote '${url}' matches pattern '${pattern}'"
                return 0
            fi
        done
    done <<< "${remotes}"

    return 1
}

main() {
  if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        usage
    fi

    if [[ $# -lt 1 || $# -gt 2 ]]; then
        die "expected 1-2 arguments, got $#. Use --help for usage."
    fi

    local session_id="$1"
    local branch="${2:-}"

    # Refuse before touching the session for blocklisted repositories.
    if repo_is_blocked; then
        log "this repository's conversation log must not be published; skipping gist."
        exit "${EXIT_BLOCKED}"
    fi

    if [[ -z "${branch}" ]]; then
        branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || printf 'session')
    fi
    # Slashes are illegal in Gist filenames; flatten branch names like fix/foo.
    local branch_safe="${branch//\//-}"

    local extract="${SCRIPT_DIR}/claude-extract-session"
    [[ -x "${extract}" ]] || die "sibling shim not found or not executable: ${extract}"

    command -v gh &>/dev/null || die "gh not found in PATH"

    # Extract -> secret Gist. gh prints the Gist URL to stdout, which becomes
    # this script's only stdout.
    "${extract}" "${session_id}" \
        | gh gist create --filename "pr-conversation-${branch_safe}.md" -
}

main "$@"